# Copy to apps/api/.env and apps/web/.env.local (see README). Never commit real values.

# Neon PostgreSQL (with pgvector), from the Neon console "Connect" dialog.
# Pooled connection (host contains -pooler) — used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no -pooler) — used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# Triage model; falls back to GEMINI_FALLBACK_MODEL if rate-limited (429) or overloaded (503).
# Development uses the lighter model first (gemini-3.8-flash was often overloaded).
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"
# How long to wait for the AI before marking a request NEEDS_REVIEW (milliseconds, 1000–120000)
TRIAGE_TIMEOUT_MS=25000

# Heating season for the "no heat" emergency rule (MM-DD, inclusive). DC: Oct 1 – May 1.
HEATING_SEASON_START="10-01"
HEATING_SEASON_END="05-01"

# Set to "off" to stop the API re-running triage for waiting requests when it starts
# TRIAGE_SWEEP="off"

# Long random string used to sign session cookies (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=""

# Where the web app and API run
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4100"

# API port
PORT=4100

# Routine jobs whose estimated cost (vendor hourly rate x typical hours) is below this may be sent to the
# best available vendor without coordinator approval. 0 turns auto-dispatch off.
AUTO_DISPATCH_LIMIT_USD=250

# Optional: where uploaded photos are stored in development (default: <repo>/uploads, gitignored)
# UPLOADS_DIR=""

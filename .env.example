# LeaseLens — reference list of every setting. Placeholders only; never commit real values.
# The apps read their own files:
#   apps/api/.env       ← copy apps/api/.env.example (full comments there)
#   apps/web/.env.local ← copy apps/web/.env.example

# ── API (apps/api/.env) ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"  # required, pooled
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"           # for migrations
GEMINI_API_KEY="your-gemini-api-key"            # Google AI Studio
GEMINI_MODEL="gemini-3.5-flash-lite"            # tried first
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"        # on 429 / 503
TRIAGE_TIMEOUT_MS=25000                         # then NEEDS_REVIEW
TRIAGE_SWEEP="on"                               # re-run waiting triage at startup
HEATING_SEASON_START="10-01"                    # "no heat" emergency window (MM-DD)
HEATING_SEASON_END="05-01"
AUTO_DISPATCH_LIMIT_USD=250                     # 0 = off
PORT=4100
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4100"                 # informational
LOG_LEVEL="info"
DEMO_MODE="off"                                # "on" = show sign-in links + demo accounts in the browser (local only, refused in production)
# UPLOADS_DIR="C:/path/to/uploads"              # default <repo>/uploads
SESSION_SECRET="replace-with-a-long-random-string"  # reserved, not used yet

# ── Web (apps/web/.env.local) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4100"

# Copy to apps/api/.env and apps/web/.env.local (see README). Never commit real values.

# Neon PostgreSQL (with pgvector). Use the pooled connection string from the Neon console.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/leaselens?sslmode=require"

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# Default model; fall back to gemini-3.5-flash-lite if rate-limited
GEMINI_MODEL="gemini-3.8-flash"

# Long random string used to sign session cookies (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=""

# Where the web app and API run
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# API port
PORT=4000

# Routine jobs below this cost may auto-dispatch without coordinator approval
AUTO_DISPATCH_LIMIT_USD=250

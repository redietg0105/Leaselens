# LeaseLens web app settings. Copy this file to apps/web/.env.local (gitignored — never commit it).

# The API's address as the browser sees it. Must match PORT / API_URL in apps/api/.env.
# NEXT_PUBLIC_ values are built into the browser code, so never put a secret here.
NEXT_PUBLIC_API_URL="http://localhost:4100"

# Demo mode is set on the API (DEMO_MODE in apps/api/.env); the sign-in page asks the API whether it is on.

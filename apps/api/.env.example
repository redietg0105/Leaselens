# Copy to apps/api/.env — never commit the real file.
# Pooled (app) and direct (migrations) Neon connection strings
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"
TRIAGE_TIMEOUT_MS=25000
HEATING_SEASON_START="10-01"
HEATING_SEASON_END="05-01"
# TRIAGE_SWEEP="off"
SESSION_SECRET=""
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4100"
PORT=4100
AUTO_DISPATCH_LIMIT_USD=250
# Optional: photo storage folder (default: <repo>/uploads)
# UPLOADS_DIR=""

# LeaseLens API settings. Copy this file to apps/api/.env and fill in your own values.
# apps/api/.env is gitignored — never commit it. The API checks these at startup and explains any problem.

# ── Database (Neon PostgreSQL with pgvector) ─────────────────────────────────────────────
# From the Neon console → your project → "Connect". Required.
# Pooled connection (the host contains "-pooler") — used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (same host without "-pooler") — used by `npm run db:migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ── AI triage (Gemini) ──────────────────────────────────────────────────────────────────
# API key from Google AI Studio → https://aistudio.google.com/apikey
# Without it the app still runs, but every request goes to NEEDS_REVIEW for a person to triage.
GEMINI_API_KEY="your-gemini-api-key"
# Model tried first, and the one used when it is rate-limited (429) or overloaded (503).
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"
# How long to wait for the AI before marking a request NEEDS_REVIEW (milliseconds, 1000–120000).
TRIAGE_TIMEOUT_MS=25000
# Re-run triage at startup for requests left waiting by a restart ("on" or "off").
TRIAGE_SWEEP="on"

# ── Emergency rules ─────────────────────────────────────────────────────────────────────
# "No heat" is an emergency only during the heating season (MM-DD, inclusive). DC: Oct 1 – May 1.
HEATING_SEASON_START="10-01"
HEATING_SEASON_END="05-01"

# ── Vendor dispatch ─────────────────────────────────────────────────────────────────────
# Routine, confidently triaged jobs whose estimated cost (vendor hourly rate × typical hours) is
# below this go straight to the best available vendor. 0 turns auto-dispatch off.
AUTO_DISPATCH_LIMIT_USD=250

# ── Demo mode (local only) ──────────────────────────────────────────────────────────────
# "on" shows the sign-in link in the browser (instead of only in this terminal) and lists the demo
# accounts on the sign-in page. Reveals which emails have accounts — never use it with real users.
# The API refuses to start with DEMO_MODE="on" when NODE_ENV is production.
DEMO_MODE="off"

# ── Server ──────────────────────────────────────────────────────────────────────────────
# Port the API listens on. 4100 (not 4000, which NoMachine uses on some machines).
PORT=4100
# The web app's address: allowed by CORS and used in sign-in links.
WEB_URL="http://localhost:3000"
# The API's own public address (informational; the web app reads NEXT_PUBLIC_API_URL).
API_URL="http://localhost:4100"
# Log detail: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL="info"
# Number of reverse proxies / load balancers in front of the API (0 = none, the default). Set it when
# deployed behind one, so rate limits see each visitor's address instead of the proxy's.
TRUST_PROXY=0
# Log the forwarded-for chain once (masked) to choose TRUST_PROXY after a deploy. Keep "off".
LOG_CLIENT_IP_ONCE="off"

# ── Photos ──────────────────────────────────────────────────────────────────────────────
# "local" (default): files in <repo>/uploads. "gcs": a Cloud Storage bucket (deployed on Cloud Run, using the
# service account — no key file).
STORAGE_DRIVER="local"
GCS_BUCKET=""

# ── Sign-in emails ──────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development: sign-in links are printed in this terminal instead.
# Deployed: Gmail SMTP with an app password (the password comes from Secret Manager, never from a file).
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""

# Where photos are stored in development. Default: <repo>/uploads (gitignored).
# UPLOADS_DIR="C:/path/to/uploads"

# Reserved for signing tokens in a later phase. Not used yet: sessions are random 256-bit tokens
# stored only as SHA-256 hashes, so no signing key is needed today. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"
